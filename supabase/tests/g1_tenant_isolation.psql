-- G1 staging-only integration test. Uses fixed test identifiers and rolls back.
-- Requires migrations 001–005 and a PostgreSQL role allowed to create
-- temporary auth.users rows. Never run against production.
\set ON_ERROR_STOP on
BEGIN;
INSERT INTO auth.users(id,aud,role,email,created_at,updated_at) VALUES
 ('00000000-0000-4000-8000-00000000c551','authenticated','authenticated','test-c551@invalid.example',now(),now()),
 ('00000000-0000-4000-8000-00000000d552','authenticated','authenticated','test-d552@invalid.example',now(),now());
INSERT INTO public.businesses(id,name,country_code) VALUES
 ('11111111-1111-4111-8111-111111111111','Tenant A','TR'),
 ('22222222-2222-4222-8222-222222222222','Tenant B','SY');
INSERT INTO public.memberships(business_id,user_id,role) VALUES
 ('11111111-1111-4111-8111-111111111111','00000000-0000-4000-8000-00000000c551','owner'),
 ('22222222-2222-4222-8222-222222222222','00000000-0000-4000-8000-00000000d552','owner');
INSERT INTO public.branches(business_id,name) VALUES
 ('11111111-1111-4111-8111-111111111111','A Branch'),
 ('22222222-2222-4222-8222-222222222222','B Branch');
SET LOCAL ROLE authenticated;
SELECT set_config('request.jwt.claim.sub','00000000-0000-4000-8000-00000000c551',true);
DO $test$
DECLARE n integer;
BEGIN
 SELECT count(*) INTO n FROM public.businesses;
 IF n<>1 THEN RAISE EXCEPTION 'A sees % businesses',n; END IF;
 SELECT count(*) INTO n FROM public.branches;
 IF n<>1 THEN RAISE EXCEPTION 'A sees % branches',n; END IF;
 SELECT count(*) INTO n FROM public.memberships;
 IF n<>1 THEN RAISE EXCEPTION 'A sees % memberships',n; END IF;
 BEGIN
   INSERT INTO public.branches(business_id,name)
    VALUES ('22222222-2222-4222-8222-222222222222','ILLEGAL');
   RAISE EXCEPTION 'CROSS_TENANT_INSERT_NOT_BLOCKED';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
 BEGIN
   INSERT INTO public.memberships(business_id,user_id,role) VALUES
     ('22222222-2222-4222-8222-222222222222','00000000-0000-4000-8000-00000000c551','owner');
   RAISE EXCEPTION 'PRIVILEGE_ESCALATION_NOT_BLOCKED';
 EXCEPTION WHEN insufficient_privilege THEN NULL;
 END;
 UPDATE public.branches SET name='ILLEGAL' WHERE name='B Branch';
 GET DIAGNOSTICS n=ROW_COUNT;
 IF n<>0 THEN RAISE EXCEPTION 'CROSS_TENANT_UPDATE_NOT_BLOCKED'; END IF;
END $test$;
SELECT set_config('request.jwt.claim.sub','00000000-0000-4000-8000-00000000d552',true);
DO $test$
DECLARE n integer;
BEGIN
 SELECT count(*) INTO n FROM public.businesses;
 IF n<>1 THEN RAISE EXCEPTION 'B sees % businesses',n; END IF;
 SELECT count(*) INTO n FROM public.branches;
 IF n<>1 THEN RAISE EXCEPTION 'B sees % branches',n; END IF;
 SELECT count(*) INTO n FROM public.memberships;
 IF n<>1 THEN RAISE EXCEPTION 'B sees % memberships',n; END IF;
END $test$;
RESET ROLE;
ROLLBACK;
