-- G1 staging-only negative RLS verification. NEVER run against production data.
-- Execute using psql with: -v owner_a=<auth.users uuid> -v owner_b=<auth.users uuid>
-- Existing Supabase Auth users must be separate and belong to no other G1 test tenants.
-- Script uses a transaction and ROLLBACK; all fixtures are temporary.
\set ON_ERROR_STOP on
begin;
create temporary table g1_ids (label text primary key, id uuid);
insert into public.businesses(name,country_code) values ('G1 Tenant A','TR')
 returning id \gset tenant_a_
insert into public.businesses(name,country_code) values ('G1 Tenant B','SY')
 returning id \gset tenant_b_
insert into public.memberships(business_id,user_id,role) values
 (:'tenant_a_id', :'owner_a'::uuid, 'owner'),
 (:'tenant_b_id', :'owner_b'::uuid, 'owner');
insert into public.branches(business_id,name) values
 (:'tenant_a_id','A Branch'),(:'tenant_b_id','B Branch');
-- Simulate the same DB role used by authenticated clients.
set local role authenticated;
select set_config('request.jwt.claim.sub', :'owner_a',true);
do $$
declare n integer;
begin
 select count(*) into n from public.businesses;
 if n <> 1 then raise exception 'RLS FAIL: user A can see % businesses (expected 1)',n; end if;
 select count(*) into n from public.branches;
 if n <> 1 then raise exception 'RLS FAIL: user A can see % branches (expected 1)',n; end if;
 select count(*) into n from public.memberships;
 if n <> 1 then raise exception 'RLS FAIL: user A can see % memberships (expected 1)',n; end if;
end $$;
select set_config('request.jwt.claim.sub', :'owner_b',true);
do $$
declare n integer;
begin
 select count(*) into n from public.businesses;
 if n <> 1 then raise exception 'RLS FAIL: user B can see % businesses (expected 1)',n; end if;
 select count(*) into n from public.branches;
 if n <> 1 then raise exception 'RLS FAIL: user B can see % branches (expected 1)',n; end if;
end $$;
rollback;
